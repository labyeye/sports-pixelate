# ── Required ────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/nestplay
JWT_SECRET=change-me-to-a-long-random-string
# Production only: comma-separated web origins allowed by CORS
ALLOWED_ORIGINS=https://sports.pixelatenest.com
NODE_ENV=development
PORT=5002
FRONTEND_URL=http://localhost:5174
# Passkeys are bound to this domain. Use a parent domain of the web app (e.g. pixelatenest.com) so the same
# passkey works on web and in the mobile app; the domain must also serve /.well-known/apple-app-site-association
# (iOS) and /.well-known/assetlinks.json (Android). Defaults to the FRONTEND_URL host.
PASSKEY_RP_ID=
# Extra origins allowed to finish a passkey ceremony (comma separated), e.g. the Android app's android:apk-key-hash origin.
PASSKEY_ORIGINS=
# iOS app ids trusted for passkeys: "<TeamID>.<bundle id>", comma separated.
PASSKEY_IOS_APP_IDS=

# ── Files ───────────────────────────────────────────────────
# Point at a PERSISTENT volume in production (default: ./uploads)
# UPLOAD_DIR=/data/uploads

# Encryption key for uploaded photos/documents (AES-256, 64 hex characters).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back it up separately and never change it once files exist — without it the
# uploaded files cannot be recovered. If unset, a key is derived from JWT_SECRET
# (works, but set a dedicated key).
UPLOAD_ENCRYPTION_KEY=

# ── Monitoring (optional) ───────────────────────────────────
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# ── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=NestAcademy
SMTP_FROM_EMAIL=

# ── WhatsApp (Meta Cloud API) ───────────────────────────────
META_WA_TOKEN=
META_WA_PHONE_ID=
# Webhook: both are REQUIRED for the webhook to work in production
META_WA_VERIFY_TOKEN=
META_APP_SECRET=

# ── Payments ────────────────────────────────────────────────
# Cashfree: platform billing (subscriptions + WhatsApp credits). Dashboard > Developers > Webhooks: URL
# https://<this API's domain>/api/webhooks/cashfree-billing (event: Payment Success). BACKEND_URL = that public https domain.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production
BACKEND_URL=
PHONEPE_ENV=sandbox
PAYTM_ENV=sandbox

# ── Web push ────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Integrations ────────────────────────────────────────────
FACE_SERVICE_URL=http://127.0.0.1:8091
FACE_SERVICE_API_KEY=
CRM_API_SECRET=
CRM_SUPPORT_WEBHOOK_URL=

# Payment safety net (utils/paymentSaga.js + paymentReconcile.js)
# Refund emails use the SMTP_* settings above (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM_NAME, SMTP_FROM_EMAIL).

# Firebase Cloud Messaging (native app push) — service-account JSON as a raw string or a file path
FCM_SERVICE_ACCOUNT=
