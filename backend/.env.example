# ── Required ────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/nestplay
JWT_SECRET=change-me-to-a-long-random-string
# Production only: comma-separated web origins allowed by CORS
ALLOWED_ORIGINS=https://sports.pixelatenest.com
NODE_ENV=development
PORT=5002
FRONTEND_URL=http://localhost:5174

# ── Files ───────────────────────────────────────────────────
# Point at a PERSISTENT volume in production (default: ./uploads)
# UPLOAD_DIR=/data/uploads

# Encryption key for uploaded photos/documents (AES-256, 64 hex characters).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back it up separately and never change it once files exist — without it the
# uploaded files cannot be recovered. If unset, a key is derived from JWT_SECRET
# (works, but set a dedicated key).
UPLOAD_ENCRYPTION_KEY=

# ── Monitoring (optional) ───────────────────────────────────
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# ── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=NestPlay
SMTP_FROM_EMAIL=

# ── WhatsApp (Meta Cloud API) ───────────────────────────────
META_WA_TOKEN=
META_WA_PHONE_ID=
# Webhook: both are REQUIRED for the webhook to work in production
META_WA_VERIFY_TOKEN=
META_APP_SECRET=

# ── Payments ────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
HDFC_MERCHANT_ID=
HDFC_ACCESS_KEY=
HDFC_ENV=sandbox
CASHFREE_ENV=sandbox
PHONEPE_ENV=sandbox
PAYTM_ENV=sandbox

# ── Web push ────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Integrations ────────────────────────────────────────────
FACE_SERVICE_URL=http://127.0.0.1:8091
FACE_SERVICE_API_KEY=
CRM_API_SECRET=
CRM_SUPPORT_WEBHOOK_URL=
